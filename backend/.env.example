# ── PM Studio 后端配置 ─────────────────────────────────────────────
# 复制成 .env 再填（.env 不会被提交；这份 example 是要提交的）。
# 后端只从环境变量读配置：少一个必填项就必须起不来，不写"无密钥降级"。

# 必填：LiteLLM 的模型名（带 provider 前缀）。
#   DashScope 通义：openai/qwen3.8-flash
#   OpenAI：       openai/gpt-4o-mini
#   DeepSeek：     deepseek/deepseek-chat
PMSTUDIO_MODEL=openai/qwen3.8-flash

# 必填：模型服务商的 key。
PMSTUDIO_API_KEY=

# 选填：OpenAI 兼容网关的 base_url（官方 OpenAI 不用填）。
#   DashScope：https://dashscope.aliyuncs.com/compatible-mode/v1
PMSTUDIO_API_BASE=

# ── 数据库 ───────────────────────────────────────────────────────────
# backend **只认 app URL**，它指向 PgBouncer（transaction mode）；缺了起不来。
# init / maintenance / backup **只认 direct URL**，它直连 PostgreSQL；缺了起不来。
# 两边不互相推导、不回落。
PMSTUDIO_DATABASE_URL=postgresql://pmstudio:pmstudio@pgbouncer:6432/pmstudio
PMSTUDIO_DIRECT_DATABASE_URL=postgresql://pmstudio:pmstudio@db:5432/pmstudio

# compose 的 db / pgbouncer 用这三个变量。开发默认值只写在 compose 里；
# 真部署必须换成强口令（T7 会拆 pmstudio_owner / pmstudio_app 两个角色）。
POSTGRES_DB=pmstudio
POSTGRES_USER=pmstudio
POSTGRES_PASSWORD=pmstudio

# 选填：每次模型调用的超时（秒）。**按次算**（一次业务动作最多重试 3 次）。
# 代码默认 90，但**真跑数据说 90 远远不够**（2026-10-03 P34 · M2a 量的，来自一次完整真跑库）：
#   integration 单次：平均 148s、最慢 145s 档（回包 9k–25k 字符）；成功过的还有 545s 那种
#   ——那是"先超时两次再成功"，`duration_ms` 从整个动作开始算，所以它不代表单次上限；
#   seat_review 也撞过一次 181s。
# 所以本地用 **300**。代价要说清：最坏一次动作 = 3 × 300 + 退避 ≈ 15 分钟才报失败。
# 调试期可以调小（如 10）看看失败路径长什么样。
# 单次上游调用的墙钟上限。300 → 150：实测 167 次成功调用的最大耗时是 143.0s，
# 300s 只会在已经超时的调用上**多占 150 秒**（失败调用耗时中位恰好 300.2s、
# 最大 900.5s = 300 × 3 次尝试）。病态挂起由熔断兜底，不靠拉长单次超时。
PMSTUDIO_MODEL_TIMEOUT=150

# 选填：透传给 LiteLLM 的供应商参数（JSON 对象）。我们自己的键
# （model / messages / timeout / num_retries）永远覆盖它，所以这里改不动超时与重试。
# **这整行是"模型相关"的**：换模型必须重看（2026-10-05 真跑教训：qwen 的
# `enable_thinking: false` 发给 glm-5.3 直接 400——供应商要求它只能是 true；
# 而思考强制开之后，16k 的输出预算会被思考吃光（`finish_reason=length` + 只吐出 `{`），
# integration 稳定超时。qwen 关思考 + 16384 + 300 秒是全部实测数据的基准配置。
# DashScope 的 qwen3 系列默认开着"思考"，实测输出里 66–88% 是 reasoning_tokens、
# integration 单次要 2–3 分钟；关掉它（下面这行）能把这类调用拉回 1 分钟以内：
# 注意：值要用**单引号**包起来，否则 `source .env` 时 bash 会把 `{` 当成命令。
#
# 另一个坑（2026-10-03 P35 · M3 量的）：**有些供应商的默认输出上限只有 8192 token**。
# 长输入的整合回包能到 21.7K 字符（≈8K+ token），正好撞上限 → JSON 断在半句上 →
# 不是合法 JSON → 整轮失败，**点重试还是同样的失败**。留样里能看见
# `finish_reason=length` + `completion_tokens=8192`（`04` G10 F34）。
# 要跑长输入就把上限抬上去（16384 实测够用）：
# PMSTUDIO_MODEL_PARAMS='{"extra_body": {"enable_thinking": false}, "max_tokens": 16384}'
# F34 修后提醒：8192 截断是配置问题不是代码问题；上面的 max_tokens 一行就是杠杆。
PMSTUDIO_MODEL_PARAMS=

# 选填：把每次模型调用的提示词与回复存进 model_calls 表（默认关）。
# 排查用：库会长（提示词原文每次几 KB～几十 KB）。要清就 DELETE FROM model_calls;
PMSTUDIO_TRACE_MODEL=0

# 选填：后端起哪个端口（scripts/dev.py 读它，默认 8000；前端代理默认也指 8000）。
PMSTUDIO_PORT=8000

# ── 多用户认证 ─────────────────────────────────────────────────────
# 选填：签名/CSRF 用的服务端密钥（真值不进库；本改造暂未使用，先占位）。
PMSTUDIO_SECRET_KEY=

# 选填：首管理员种子（OpsSettings，T7 的 init job 使用）。两个都给且 users 表为空
# 时建一个 active admin；任一为空或已有用户则跳过（幂等）。真值不进库。
PMSTUDIO_FIRST_ADMIN_USER=
PMSTUDIO_FIRST_ADMIN_PASSWORD=

# 选填：会话滑动上限（天）/ 绝对上限（天）。默认 30 / 90。
PMSTUDIO_SESSION_TTL_DAYS=30
PMSTUDIO_SESSION_ABSOLUTE_DAYS=90

# ── 登录限流 ────────────────────────────────────────────────────────────────
# 三层，挡的是三种不同形状的攻击（高并发 P3）：
#   ① 失败锁（IP × 用户名）：窗口内连败到数即锁这么久。**回 401**，
#      与密码错逐字节相同——保持不可枚举。
#   ② 尝试闸 · 每 IP：挡住"单 IP 喷很多账号"（每个用户名各只错一次，
#      失败锁永远不触发）。
#   ③ 尝试闸 · 每用户名：挡住"很多 IP 撞一个账号"（分布式撞库）。
# ② ③ **回 429 + Retry-After**——速率问题不是凭证问题。
PMSTUDIO_LOGIN_MAX_FAILS=5
PMSTUDIO_LOGIN_LOCK_MINUTES=15
PMSTUDIO_LOGIN_IP_MAX_ATTEMPTS=20
PMSTUDIO_LOGIN_USER_MAX_ATTEMPTS=10
PMSTUDIO_LOGIN_ATTEMPT_WINDOW_SECONDS=60

# 登录哈希隔离舱容量：**内存与延迟的旋钮，不是安全参数**。argon2 每次约 64MB，
# 超过 min(4, CPU) 对单事件循环的登录吞吐没有额外收益。
PMSTUDIO_LOGIN_HASH_CONCURRENCY=4

# ── Redis：登录限流的跨 worker 共享计数 ─────────────────────────────────────
# 留空 = 只用进程内计数。单 worker 开发够用，**多 worker 下锁不住**
# （每个 worker 各有一份），`scripts/dev.py` 会就此打警告。
PMSTUDIO_REDIS_URL=
# 调 Redis 的墙钟上限。**必须小**：不设的话 Redis"连上但不回包"会让登录
# 卡住数秒（实测 5 秒），降级分支根本走不到。
PMSTUDIO_REDIS_TIMEOUT=0.3
# 连接池上界。redis-py 的 asyncio 池**默认 100**，200 并发会直接
# `MaxConnectionsError`；我们就是要跑 200+。
PMSTUDIO_REDIS_MAX_CONNECTIONS=256

# uvicorn worker 进程数（高并发 P4）。**默认 1**：多 worker 需要配 Redis
# （跨进程 SSE 扇出 + 共享限流），否则两者都静默退化回进程内。
# 注意与热重载互斥：uvicorn 的 --workers 不能与 --reload 同用，
# 所以多 worker 时 scripts/dev.py 要加 --no-reload。
PMSTUDIO_WORKERS=1

# ── 向量检索：首次跑要下 ONNX 模型（`BAAI/bge-small-zh-v1.5`，512 维，约 90MB） ──
# 留空 = 用 huggingface.co 默认源。**很多网络环境下它下不动**，那两条最常见：
#   ① huggingface.co 连不上（超时 / Errno 99）；
#   ② 文件走 Xet 存储（cas-server.xethub.hf.co）被 401 拦下。
# 下面两行是 2026-10-19 实测可用的组合（下载成功，26.9s，512 维）：
#   HF_ENDPOINT      换镜像源（hf-mirror.com 可达时）；
#   HF_HUB_DISABLE_XET  禁掉 Xet 后端，退回经典 LFS 通道。
# 注意模型走的是 `Qdrant/bge-small-zh-v1.5`（fastembed 挑的 ONNX 仓库，
# 不是 `BAAI/` 那个——后者没有 onnx 文件）。
# **下不下来不会致命**：扩展/模型/推理任一失败都退回纯 FTS5，上传与检索照常可用，
# 只是没有语义召回那一路（`02` §11.0.79）。
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# ── MCP server（可选；留空 = 不启用）────────────────────────────────────
# JSON 数组，每项一个 server。两种传输都是 MCP 协议规范定义的：
#   · stdio：本地子进程（Claude Desktop / Cursor 那类配置的标准形态）
#   · http ：远程（Streamable HTTP）
# 工具名会加上 `mcp__<server>__` 前缀——多 server 同名工具不会撞。
#
# 例（stdio）：
#   PMSTUDIO_MCP_SERVERS=[{"name":"demo","transport":"stdio","command":"python3","args":["scripts/mcp_demo_server.py"]}]
#   · `cwd` 是子进程的工作目录，**缺省 = 继承本进程的 CWD**。上面那行把
#     `scripts/mcp_demo_server.py` 写成相对路径，所以只有从 `backend/` 启动才成立。
#     想从任何目录都能起，就显式给一个：`"cwd":"/path/to/ai-pm/backend"`。
# 例（http）：
#   PMSTUDIO_MCP_SERVERS=[{"name":"web","transport":"http","url":"http://127.0.0.1:9000/mcp"}]
#
# ⚠️ stdio 的 command 必须指向**装了 mcp 这个包**的解释器
# （`backend/.venv/bin/python3`）——系统 python3 装不上 → server 起不来。
# 起服务后，`scripts/dev.py` 会打一行"MCP server X 就绪：N 个工具"。
#
# ⚠️ **当前消费者只有 `scripts/mcp_probe.py`**：主服务起起来**不连 MCP**
# （`scripts/dev.py` 只打一行配置状态，不建连接）。MCP 是**只读旁路**，
# 不进主闭环、不进 API 层、不写库（见 `.codex/docs/设计/02-编排与数据.md §4.9`）。
PMSTUDIO_MCP_SERVERS=
