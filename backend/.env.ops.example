# ── PM Studio 运维侧配置（init / maintenance / backup）──────────────
# 复制成 backend/.env.ops 再填。这个文件**只给一次性 init 与维护 job**，
# 不挂到 backend 运行时：backend 只拿 app URL（backend/.env）。
# 两边不互相推导、不回落。

# ── PostgreSQL 引导 / 角色 ─────────────────────────────────────────────
# compose 的 db 服务也读这个文件：POSTGRES_* 是**超级用户**（只给 init --bootstrap）。
POSTGRES_DB=pmstudio
POSTGRES_USER=pmstudio_bootstrap
POSTGRES_PASSWORD=change-me-bootstrap

# 必填：bootstrap 超级用户 URL，只给 `init_db.py --bootstrap`。
# 它建 vector 扩展、pmstudio_owner / pmstudio_app 角色、GRANT、PgBouncer auth_file。
PMSTUDIO_BOOTSTRAP_DATABASE_URL=postgresql://pmstudio_bootstrap:change-me-bootstrap@db:5432/pmstudio

# 必填：owner 直连（绕过 PgBouncer），给 schema-only / finalize / maintenance / backup。
PMSTUDIO_DIRECT_DATABASE_URL=postgresql://pmstudio_owner:change-me-owner@db:5432/pmstudio

# 必填：两个角色的口令（init 写进 PostgreSQL 与 PgBouncer auth_file）。
# PMSTUDIO_OWNER_PASSWORD 必须与上面 direct URL 里的口令一致；
# PMSTUDIO_APP_PASSWORD 必须与 backend/.env 的 app URL 口令一致。
PMSTUDIO_OWNER_PASSWORD=change-me-owner
PMSTUDIO_APP_PASSWORD=change-me-app

# 必填：首管理员种子。`users` 为空时 finalize 用它建一个 active admin；
# 任一为空会**硬失败**（不是跳过）。已有用户时不会重复建（幂等）。
# 真值不进库；这里给的是可直接跑起来的开发占位，部署前必须换掉。
PMSTUDIO_FIRST_ADMIN_USER=admin
PMSTUDIO_FIRST_ADMIN_PASSWORD=change-me-admin
